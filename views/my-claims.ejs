<%- include('partials/header') %>

<section class="page-header">
  <h1>My Claims</h1>
</section>

<% if (claims.length === 0) { %>
  <div class="empty-state">You have not submitted any claims yet.</div>
<% } else { %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Item</th>
          <th>Explanation</th>
          <th>Status</th>
          <th>Submitted On</th>
        </tr>
      </thead>
      <tbody>
        <% claims.forEach((claim) => { %>
          <tr>
            <td><%= claim.item ? claim.item.name : 'Item removed' %></td>
            <td><%= claim.explanation %></td>
            <td><%= claim.status %></td>
            <td><%= new Date(claim.createdAt).toLocaleDateString() %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('partials/footer') %>
